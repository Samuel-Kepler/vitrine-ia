# Copie para .env e preencha SÓ o provedor que for usar.
#
# AI_PROVIDER escolhe o provedor: anthropic | google | groq | openrouter | mock
# Sem AI_PROVIDER, o app usa o primeiro provedor com chave definida
# (na ordem acima) e cai no modelo mock se não houver nenhuma.
AI_PROVIDER=

# Opcional: sobrescreve o modelo padrão do provedor.
# Padrões: anthropic=claude-haiku-5-5 | google=gemini-flash-latest
#          groq=openai/gpt-oss-120b | openrouter=nvidia/nemotron-3-ultra-550b-a55b:free
AI_MODEL=

# Anthropic (pago)            https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google AI Studio (free tier) https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq (free tier)             https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (modelos :free)   https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Segredo do JWT de sessão (troque em produção)
JWT_SECRET=
