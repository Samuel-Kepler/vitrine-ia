# Provedor padrão do servidor. Pode ser trocado na tela (ícone de engrenagem).
# mock | groq | google | anthropic | ollama | openai-compatible
# Sem AI_PROVIDER: usa o primeiro provedor de nuvem com chave; senão, mock.
# Provedores locais (ollama / openai-compatible) nunca são escolhidos sozinhos.
AI_PROVIDER=
AI_MODEL=

GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# IA local
OLLAMA_BASE_URL=http://localhost:11434/api
# LM Studio: http://localhost:1234/v1 · llama.cpp: http://127.0.0.1:8080/v1 · OpenRouter: https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_API_KEY=

# Hosts remotos aceitos como baseURL vindo da tela (localhost sempre é aceito).
ALLOWED_REMOTE_HOSTS=openrouter.ai,api.groq.com,api.openai.com,api.together.xyz
