{
  "name": "uigen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--require ./node-compat.cjs' next dev --turbopack",
    "dev:daemon": "NODE_OPTIONS='--require ./node-compat.cjs' next dev --turbopack > logs.txt 2>&1 & echo 'Server started, writing logs to logs.txt'",
    "build": "NODE_OPTIONS='--require ./node-compat.cjs' next build",
    "start": "NODE_OPTIONS='--require ./node-compat.cjs' next start",
    "lint": "eslint .",
    "test": "vitest",
    "setup": "npm install && npx prisma generate && npx prisma migrate dev",
    "db:reset": "npx prisma migrate reset --force",
    "test:e2e": "playwright test",
    "test:e2e:real": "E2E_PROVIDER=anthropic playwright test",
    "test:e2e:groq": "E2E_PROVIDER=groq playwright test",
    "docs:capture": "CAPTURE=1 playwright test e2e/capture-docs.spec.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@ai-sdk/google": "^4.0.121",
    "@ai-sdk/groq": "^4.0.84",
    "@ai-sdk/provider": "^4.0.38",
    "@ai-sdk/react": "^4.0.177",
    "@babel/standalone": "^7.27.6",
    "@monaco-editor/react": "^4.7.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@prisma/client": "^6.10.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tailwindcss/typography": "^0.5.16",
    "ai": "^7.0.173",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jose": "^6.0.11",
    "lucide-react": "^0.517.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.3",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__standalone": "^7.1.9",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "9.29.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^26.1.0",
    "prisma": "^6.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
